{
  "scripts": {
    "build": "npm run build:vendor && npm run build:css",
    "build:vendor": "node scripts/copy-vendor.js",
    "build:css": "tailwindcss -i ./static/src/app.css -o ./static/dist/app.css --minify",
    "watch:css": "tailwindcss -i ./static/src/app.css -o ./static/dist/app.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  },
  "dependencies": {
    "alpinejs": "3.14.8",
    "highcharts": "^13.0.0",
    "htmx.org": "2.0.4",
    "sortablejs": "^1.15.7"
  }
}
